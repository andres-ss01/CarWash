# =====================================================================
# CONFIGURACIÓN (copia este archivo como .env y rellénalo)
# =====================================================================

# Puerto del servidor (solo local; Vercel no lo usa)
PORT=3000

# Zona horaria del establecimiento (zona IANA). Las citas se guardan como hora "de pared"
# (DATETIME sin zona) y los servidores en la nube suelen estar en UTC.
# OJO: en Vercel la variable "TZ" está reservada, por eso se usa APP_TZ.
APP_TZ=America/Mexico_City

# ---------------------------------------------------------------------
# BASE DE DATOS EN LA NUBE (Aiven for MySQL)
# Todos estos datos están en Aiven -> tu servicio -> pestaña "Overview"
# ---------------------------------------------------------------------
DB_HOST=mysql-xxxxxxxx-tuproyecto.a.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=tu_password_de_aiven
DB_NAME=defaultdb

# Aiven exige conexión cifrada
DB_SSL=true

# Certificado CA de Aiven (botón "CA certificate" en Overview). Elige UNA forma:
#  a) Archivo local: guarda el certificado como ca.pem en la raíz del proyecto
DB_SSL_CA=./ca.pem
#  b) Variable de entorno (para Vercel/Render/Railway, sin subir el archivo): pega TODO el
#     contenido del certificado; los saltos de línea pueden ir como \n
# DB_SSL_CA_CONTENT=-----BEGIN CERTIFICATE-----\nMIIE...\n-----END CERTIFICATE-----

# Opcional: fuerza la zona horaria de la sesión MySQL (formato +HH:MM o -HH:MM).
# Si lo omites se calcula a partir de APP_TZ. México (sin horario de verano): -06:00
# DB_TIMEZONE=-06:00

# ---------------------------------------------------------------------
# (Alternativa) MySQL LOCAL: usa esto en lugar del bloque de Aiven
# ---------------------------------------------------------------------
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=tu_password
# DB_NAME=carwash
# DB_SSL=false

# Conexiones máximas del pool por instancia (en Vercel mantenlo bajo; por defecto 5)
# DB_POOL_LIMIT=5

# --- Autenticación (JWT) ---
# Obligatorio. Genera uno largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# --- Reglas de agendamiento ---
# Cuántas citas pueden traslaparse a la vez (el establecimiento no tiene bahías definidas)
CITAS_SIMULTANEAS=2
# Intervalo (minutos) entre horarios ofrecidos en /api/citas/disponibilidad
SLOT_MIN=30
